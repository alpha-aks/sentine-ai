{
  "name": "@sentinel-ai/vision-guard-service",
  "version": "1.0.0",
  "description": "Vision Guard AI Microservice Foundation for SentinelAI Platform",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "node -r ts-node/register --test src/__tests__/vision-foundation.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@sentinel-ai/config": "file:../../packages/config",
    "@sentinel-ai/event-sdk": "file:../../packages/event-sdk",
    "@sentinel-ai/logger": "file:../../packages/logger",
    "@sentinel-ai/security": "file:../../packages/security",
    "@sentinel-ai/types": "file:../../packages/types",
    "@sentinel-ai/utils": "file:../../packages/utils",
    "@sentinel-ai/validation": "file:../../packages/validation",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
